# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# BOPIS run outputs. Each run is a timestamped directory of CSVs plus optional
# 100 ms sampler traces, so committing them would bloat the repo quickly.
# Commit a specific run deliberately with `git add -f runs/<timestamp>` when it
# is the one being reported.
runs/

# Cached datasets. Dolly 15k is ~13 MB and reproducible from the recorded
# SHA-256; re-fetch with `python -m bopis dataset`.
data/

# Generated dashboard payloads. The run directory is authoritative; the root
# copy is the automatic data source for bopis.html.
dashboard/dashboard_data.js
dashboard_data.js

# Model weights, should any land here
*.gguf
*.safetensors
*.bin

# QA scratch
.qa-*.mjs
qa-*.png

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
